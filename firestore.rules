rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin custom claim is set server-side only, via
    // src/app/api/admin/bootstrap-claim/route.ts — never trust anything
    // else from the client to decide this.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Category doc ID is the slugified name (see slugify() in
    // src/lib/firebase/songs.ts), so "no duplicate categories" is enforced
    // right here: creating a category that already exists is rejected.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/categories/$(categoryId))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      // Categories are only ever created/deleted by the admin UI — never
      // edited in place — so update is disabled outright rather than left
      // open to anything an admin token could be tricked into sending.
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && (
          !("artist" in request.resource.data)
          || request.resource.data.artist == null
          || (request.resource.data.artist is string && request.resource.data.artist.size() <= 200)
        )
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 100
        && request.resource.data.categoryName is string
        && request.resource.data.categoryName.size() <= 100
        && request.resource.data.audioPath is string
        && request.resource.data.audioPath.size() > 0
        && (
          !("thumbnailPath" in request.resource.data)
          || request.resource.data.thumbnailPath == null
          || request.resource.data.thumbnailPath is string
        )
        && (
          !("duration" in request.resource.data)
          || request.resource.data.duration == null
          || request.resource.data.duration is number
        )
        // Prevents an admin-authenticated client from spoofing a different
        // uploader's email in the stored `createdBy` field.
        && request.resource.data.createdBy == request.auth.token.email;
      // Songs are only ever created/deleted — never edited in place.
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
